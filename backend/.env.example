# Copy to .env for local development (.env is git-ignored). Never commit real values.
# In production these are set in the host's dashboard (see render.yaml), not in a file.

# dev | test | prod. prod refuses to start with an unsafe configuration.
BUDGET_APP_ENV=dev

# SQLite for local development; Postgres URL (with ?sslmode=require) in production.
BUDGET_APP_DATABASE_URL=sqlite:///./sql_app.db

# Signs login tokens. In prod it must be random and at least 32 characters:
#   python -c "import secrets; print(secrets.token_hex(32))"
BUDGET_APP_SECRET_KEY=dev-secret-key
BUDGET_APP_ALGORITHM=HS256
BUDGET_APP_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list (or JSON list) of allowed frontend origins. '*' is rejected in prod.
BUDGET_APP_CORS_ORIGINS=http://localhost:5173

# Timezone used to decide when a recurring budget's cycle has ended.
BUDGET_APP_TIMEZONE=America/Toronto

# Optional
# BUDGET_APP_DEBUG=false                 # true also exposes /docs in prod
# BUDGET_APP_RATE_LIMIT_ENABLED=true
# BUDGET_APP_LOGIN_RATE_LIMIT=10/minute
# BUDGET_APP_REGISTER_RATE_LIMIT=5/minute
